# ===== Telegram (the only thing you MUST fill in) ========================
# From @BotFather on Telegram: /newbot
BOT_TOKEN=123456:ABC-your-token-here

# Your chat id, from @userinfobot. Comma separated for several people.
CHAT_IDS=

DAILY_HOUR=9
DAILY_MINUTE=0
TIMEZONE=Africa/Tunis

# ===== Data source =======================================================
# hybrid      = free CSVs first, API-Football only when the card is thin.
#               Costs 0 API requests on a normal match day. (recommended)
# free        = football-data.co.uk CSVs only. No key, no signup, no limits.
# apifootball = live API only (needs a key, free plan = 100 req/day)
# mock        = offline generated data, for testing with no network
PROVIDER=hybrid

# Grow the card across following days until it has this many fixtures,
# so Mondays and international breaks still produce a real ticket.
MIN_CARD_SIZE=14

# ----- API-Football (optional; only used when the free card is thin) -----
# Free key, 100 requests/day, no credit card: https://dashboard.api-football.com
APIFOOTBALL_KEY=
# If you registered directly at api-sports.io (recommended):
APIFOOTBALL_HOST=v3.football.api-sports.io
# If you registered through RapidAPI instead, use this one:
# APIFOOTBALL_HOST=api-football-v1.p.rapidapi.com

# Which leagues to pull. 39=EPL 140=LaLiga 135=SerieA 78=Bundesliga
# 61=Ligue1 94=Primeira 88=Eredivisie 203=SuperLig
LEAGUE_IDS=39,140,135,78,61,94,88,203
# 8 = Bet365, 6 = Bwin, 2 = Marathonbet
BOOKMAKER_ID=8

# Safety rails so you can never blow the 100/day free quota by accident.
APIFOOTBALL_DAILY_BUDGET=80
APIFOOTBALL_FIXTURES_TTL=10800     # cache fixtures 3h
APIFOOTBALL_ODDS_TTL=7200          # cache odds 2h
APIFOOTBALL_STANDINGS_TTL=43200    # cache standings 12h

# ===== Pricing (this section is worth more than the model) ===============
# max  = best price available anywhere. In the backtest this was the
#        difference between -28% and +14% ROI. Requires accounts at a few
#        books so you can actually take the best price.
# b365 = one bookmaker   |   avg = market average
PRICE_SOURCE=max

# power = strips more margin from long shots (correct)
# proportional = naive divide-by-overround
DEVIG_METHOD=power

# Double chance inside an acca must come from a single book, not from
# combining two books' prices. This haircut keeps that price realistic.
DC_HAIRCUT=0.015

# ===== Model =============================================================
# 0 = trust the bookmaker completely, 1 = trust our Poisson model completely.
# Backtest: at 1.0 the model claimed 14.9% on tickets that won 1.9%. Stay low.
MODEL_WEIGHT=0.10

# ===== Ticket shape ======================================================
TARGET_ODDS=30.0          # the bomb ticket target
MAX_LEG_ODDS=2.30         # keeps the bomb short without chasing long shots
MIN_LEG_ODDS=1.03

SAFE_MIN_PROB=0.68
SAFE_MIN_LEGS=3
SAFE_MAX_LEGS=5
SAFE_MIN_TOTAL_ODDS=1.45
# Double chance is excluded on purpose: it wins more often and loses more
# money (-10.9% vs -3.9% ROI). Add 1X,X2 back only if you've read BACKTEST.md.
SAFE_MARKETS=1,2,O2.5,U2.5

BOMB_MIN_PROB=0.22
BOMB_MAX_LEGS=12

# -1 disables the filter. De-vigged edges are mostly negative, which is
# simply the truth about betting markets.
MIN_EDGE=-1.0
